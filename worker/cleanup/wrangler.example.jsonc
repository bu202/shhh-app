{
  // ⚠️ **이것은 템플릿이다. 이 파일로는 배포되지 않는다.**
  //    `wrangler deploy --config` 가 가리키는 이름은 `wrangler.jsonc` 이고, 그 파일은
  //    **저장소에 없다**(`.gitignore`). 만드는 절차는 `docs/OPS_RUNBOOK.md` §3 이다:
  //
  //      cp worker/cleanup/wrangler.example.jsonc worker/cleanup/wrangler.jsonc
  //      # 만들어진 파일의 LEDGER database_id 를 실제 값으로 바꾼다
  //      npx wrangler deploy --config worker/cleanup/wrangler.jsonc
  //
  //    왜 이렇게 갈랐나(2026-08-19): 예전에는 이 자리에 `"<TODO: … 채운다>"` 가 **배포 가능한
  //    설정 파일 안에** 있었다. 그러면 두 가지가 다 나쁘다 — 그대로 배포하면 바인딩이 가짜라
  //    첫 질의에서 터지고, 누군가 실제 id 를 채워 커밋하면 다음 사람이 그것을 템플릿으로 읽는다.
  //    템플릿과 실제 설정을 파일로 갈라 두면 **placeholder 가 배포 경로에 들어갈 수 없다.**
  "name": "shhh-cleanup",
  "main": "index.js",
  "compatibility_date": "2026-08-07",
  "observability": { "enabled": true },
  // ⛔ **`workers.dev` 주소를 열지 않는다.** 기본값이 `true` 라(공식 문서 「Defaults to `true`」)
  //    적지 않으면 배포하는 순간 `shhh-cleanup.<계정>.workers.dev` 가 인터넷에 뜬다.
  //    이 Worker 는 cron 으로만 돈다 — `index.js` 에 `fetch` 핸들러가 아예 없다.
  //    공식 문서도 같은 경우를 든다: "if you have a Worker that is only for `scheduled` events,
  //    you can set this to `false`". route 도 두지 않는다.
  "workers_dev": false,
  // 1시간마다. 무료 계정의 Cron Trigger 한도는 **계정당 5개**이고 이건 그중 하나다.
  // 무료 scheduled Worker 의 CPU 한도는 10ms 라, 대상마다 LIMIT 을 두고 나눠 지운다.
  "triggers": { "crons": ["0 * * * *"] },
  // ⚠️ 정리 Worker 는 **두 DB 를 다 만진다.** 주 D1 에서 만료된 세션·리미터·소비 표식을 지우고,
  //    ledger 에서 확정된 삭제 표식을 지운다. 하나라도 빠지면 첫 실행에서 터진다.
  "d1_databases": [
    { "binding": "DB", "database_name": "shhh-db", "database_id": "c279078b-cb82-4926-a593-461993cd1f77" },
    // ⬇️ 아직 만들지 않은 DB 다. `wrangler d1 create shhh-ledger` 가 주는 id 로 **복사본에서** 바꾼다.
    { "binding": "LEDGER", "database_name": "shhh-ledger", "database_id": "0000PLACEHOLDER-0000-0000-0000-000000000000" }
  ],
  // ⚠️ **백업 inventory 를 자동으로 맞추는 데 쓴다**(2026-08-27 · 위협 85). R2 lifecycle 은
  //    알려 주지 않고 객체를 지우는데, 그 객체가 「아직 있다」는 이유로 삭제 표식이 막혀
  //    있으므로 아무도 물어보지 않으면 그 표식이 영원히 남는다.
  //    크론이 `head()` 로 존재만 확인한다 — **본문은 받지 않는다**(백업 하나가 Worker
  //    메모리 한도 128MB 를 그대로 넘긴다).
  // ⛔ 막는 행이 있는데 이 바인딩이 없으면 정리 회차가 **실패로 끝난다.** 조용히 넘어가지
  //    않는다 — 그 배포는 백업 inventory 를 영원히 못 닫기 때문이다.
  // ⬇️ 버킷도 아직 만들지 않았다(`docs/OPS_RUNBOOK.md` §18-2).
  "r2_buckets": [
    { "binding": "BACKUPS", "bucket_name": "shhh-backups" }
  ]
}
