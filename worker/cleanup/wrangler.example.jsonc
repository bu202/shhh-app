{
  // ⚠️ **이 파일은 아직 실행 가능한 설정이 아니다.** ledger D1 이 만들어지지 않았고,
  //    `database_id` 를 가짜로 채워 넣지 않았다 — 가짜 id 를 넣으면 배포는 되고 첫 질의에서
  //    터진다. 만드는 절차는 docs/OPS_RUNBOOK.md 의 「ledger D1 만들기」에 있다.
  //
  // 실제 배포 전에 할 일:
  //   1. npx wrangler d1 create shhh-ledger        → 나오는 database_id 를 아래 <TODO> 자리에 넣는다
  //   2. npx wrangler d1 execute shhh-ledger --remote --file worker/ledger-schema.sql
  //   3. 같은 database_id 를 Pages 프로젝트의 LEDGER 바인딩에도 등록한다(대시보드)
  //   4. npx wrangler deploy --config worker/cleanup/wrangler.jsonc
  //
  // ⚠️ 1~4 는 전부 **되돌리기 어렵거나 원격에 영향을 주는 작업**이라 별도 승인 대상이다.
  "name": "shhh-cleanup",
  "main": "index.js",
  "compatibility_date": "2026-08-07",
  "observability": { "enabled": true },
  // ⛔ **`workers.dev` 주소를 열지 않는다.** 기본값이 `true` 라(공식 문서 「Defaults to `true`」)
  //    적지 않으면 배포하는 순간 `shhh-cleanup.<계정>.workers.dev` 가 인터넷에 뜬다.
  //    이 Worker 는 cron 으로만 돈다 — `index.js` 에 `fetch` 핸들러가 아예 없다.
  //    공식 문서도 같은 경우를 든다: "if you have a Worker that is only for `scheduled` events,
  //    you can set this to `false`". route 도 두지 않는다.
  "workers_dev": false,
  // 1시간마다. 무료 계정의 Cron Trigger 한도는 **계정당 5개**이고 이건 그중 하나다.
  // 무료 scheduled Worker 의 CPU 한도는 10ms 라, 대상마다 LIMIT 을 두고 나눠 지운다.
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "shhh-db", "database_id": "c279078b-cb82-4926-a593-461993cd1f77" },
    { "binding": "LEDGER", "database_name": "shhh-ledger", "database_id": "<TODO: wrangler d1 create 후 채운다>" }
  ]
}
